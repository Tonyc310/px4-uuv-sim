<?xml version="1.0"?>
<!-- Open water with the BlueROV2 Heavy: no surface, no seabed. -->
<sdf version="1.9">
  <world name="water">
    <!-- uuv_dynamics' value, so Gazebo's weight matches the library's. Gazebo's default is 9.8. -->
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Water's blue behind the vehicle in Gazebo's window; the physics doesn't read it. -->
    <scene>
      <ambient>0.4 0.4 0.4</ambient>
      <background>0.05 0.22 0.35</background>
    </scene>
    <light type="directional" name="sun">
      <!-- Its outline would be drawn at the origin, through the vehicle. -->
      <visualize>false</visualize>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <include>
      <uri>model://bluerov2_heavy</uri>
    </include>
  </world>
</sdf>
