<?xml version="1.0"?>
<!-- Gazebo moves the rigid body and applies its weight; the Fossen plugin applies buoyancy and the
     water's forces. Mass and inertia: C.-J. Wu, "6-DoF Modelling and Control of a Remotely Operated
     Vehicle", Master's thesis, Flinders University, 2018, Table 5.1, p. 48, the values uuv_dynamics
     holds. The Gazebo test fails if the two disagree. -->
<sdf version="1.9">
  <model name="bluerov2_heavy">
    <!-- The link's origin is the vehicle's body origin, its centre of buoyancy, with x forward, y
         left and z up. The plugin applies its wrench there. -->
    <link name="base_link">
      <inertial>
        <!-- The centre of gravity, 2 cm below the centre of buoyancy (Table 5.1). -->
        <pose>0 0 -0.02 0 0 0</pose>
        <mass>11.5</mass>
        <!-- Gazebo takes the inertia about the centre of gravity. Wu's 0.16 kg m^2 is about the
             origin's axes, so roll and pitch lose m z_g^2 = 11.5 * 0.02^2 = 0.0046 kg m^2. -->
        <inertia>
          <ixx>0.1554</ixx>
          <iyy>0.1554</iyy>
          <izz>0.16</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- PX4's mesh of the Heavy, from PX4's models, placed as PX4's own model places it. -->
      <visual name="hull">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://uuv_bluerov2_heavy/meshes/BlueROV2heavy.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <plugin filename="uuv_gazebo_fossen_dynamics" name="uuv_gazebo::FossenDynamics">
      <link_name>base_link</link_name>
    </plugin>
  </model>
</sdf>
